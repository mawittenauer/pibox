#!/usr/bin/env bash
set -euo pipefail

APP_NAME="pibox"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${APP_NAME}"
HOSTS_FILE="${HOSTS_FILE:-$CONFIG_DIR/hosts.conf}"

# Base commands shown for ALL OS types (label|command-id|ssh-command)
BASE_COMMANDS=(
  "SSH Shell|ssh-shell|__SSH_SHELL__"
  "Reboot|reboot|sudo -n reboot || sudo reboot"
  "Power Off|poweroff|sudo -n poweroff || sudo poweroff"
  "Update (apt)|update|sudo -n apt update && sudo -n apt -y upgrade || (sudo apt update && sudo apt -y upgrade)"
  "Uptime|uptime|uptime"
  "Disk Usage|disk-usage|df -h"
  "Memory|memory|free -h"
  "Systemctl status|systemctl|systemctl --no-pager --full status"
)

# Extra commands for FullPageOS only
FULLPAGEOS_COMMANDS=(
  "Set FullPageOS URL|set-url|__SET_FULLPAGEOS_URL__"
)

die() { echo "${APP_NAME}: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Missing dependency: $1"; }

need whiptail
need ssh
need awk
need sed
need grep

if [[ ! -f "$HOSTS_FILE" ]]; then
  die "Hosts config not found: $HOSTS_FILE
Create it like:
  mkdir -p \"$CONFIG_DIR\"
  nano \"$HOSTS_FILE\""
fi

# Load non-empty, non-comment lines
mapfile -t HOST_LINES < <(grep -vE '^\s*($|#)' "$HOSTS_FILE" || true)
[[ ${#HOST_LINES[@]} -gt 0 ]] || die "No hosts found in $HOSTS_FILE"

# Build host menu items
HOST_MENU_ITEMS=()
for line in "${HOST_LINES[@]}"; do
  # name|host|user|port|os
  IFS='|' read -r name host user port os <<<"$line"
  [[ -n "${name:-}" && -n "${host:-}" ]] || continue
  user="${user:-pi}"
  port="${port:-22}"
  os="${os:-linux}"
  HOST_MENU_ITEMS+=("$name" "$user@$host:$port ($os)")
done

choose_host() {
  local choice
  choice=$(whiptail --title "$APP_NAME" \
    --menu "Select a host" 20 90 12 \
    "${HOST_MENU_ITEMS[@]}" \
    3>&1 1>&2 2>&3) || return 1

  for line in "${HOST_LINES[@]}"; do
    IFS='|' read -r name host user port os <<<"$line"
    if [[ "$name" == "$choice" ]]; then
      echo "$name|${host}|${user:-pi}|${port:-22}|${os:-linux}"
      return 0
    fi
  done
  return 1
}

choose_command() {
  local os="$1"
  local cmd_menu=()
  local entry label remote_cmd

  # Base commands for everyone
  for entry in "${BASE_COMMANDS[@]}"; do
    IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
    cmd_menu+=("$label" "")
  done

  # Add OS-specific commands
  if [[ "$os" == "fullpageos" ]]; then
    for entry in "${FULLPAGEOS_COMMANDS[@]}"; do
      IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
      cmd_menu+=("$label" "")
    done
  fi

  local choice
  choice=$(whiptail --title "$APP_NAME" \
    --menu "Select a command" 22 90 14 \
    "${cmd_menu[@]}" \
    3>&1 1>&2 2>&3) || return 1

  # Resolve selected label to command
  for entry in "${BASE_COMMANDS[@]}"; do
    IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
    [[ "$label" == "$choice" ]] && { echo "$label|$cmd_id|$remote_cmd"; return 0; }
  done

  if [[ "$os" == "fullpageos" ]]; then
    for entry in "${FULLPAGEOS_COMMANDS[@]}"; do
      IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
      [[ "$label" == "$choice" ]] && { echo "$label|$cmd_id|$remote_cmd"; return 0; }
    done
  fi

  return 1
}

# Get command by ID
get_command_by_id() {
  local cmd_id="$1" os="$2"
  
  # Search base commands
  for entry in "${BASE_COMMANDS[@]}"; do
    IFS='|' read -r label entry_id remote_cmd <<<"$entry"
    if [[ "$entry_id" == "$cmd_id" ]]; then
      echo "$label|$entry_id|$remote_cmd"
      return 0
    fi
  done
  
  # Search OS-specific commands
  if [[ "$os" == "fullpageos" ]]; then
    for entry in "${FULLPAGEOS_COMMANDS[@]}"; do
      IFS='|' read -r label entry_id remote_cmd <<<"$entry"
      if [[ "$entry_id" == "$cmd_id" ]]; then
        echo "$label|$entry_id|$remote_cmd"
        return 0
      fi
    done
  fi
  
  return 1
}

# Get host by name
get_host_by_name() {
  local search_name="$1"
  
  for line in "${HOST_LINES[@]}"; do
    IFS='|' read -r name host user port os <<<"$line"
    if [[ "$name" == "$search_name" ]]; then
      echo "$name|${host}|${user:-pi}|${port:-22}|${os:-linux}"
      return 0
    fi
  done
  
  return 1
}

run_ssh_cmd() {
  local host="$1" user="$2" port="$3" remote_cmd="$4"
  local target="${user}@${host}"

  if [[ "$remote_cmd" == "__SSH_SHELL__" ]]; then
    exec ssh -p "$port" "$target"
  fi

  local output
  if output=$(ssh -p "$port" "$target" -- "$remote_cmd" 2>&1); then
    whiptail --title "$APP_NAME" --scrolltext --msgbox "$output" 25 100
  else
    whiptail --title "$APP_NAME" --scrolltext --msgbox "Command failed:\n\n$output" 25 100
  fi
}

set_fullpageos_url() {
  local host="$1" user="$2" port="$3"
  local target="${user}@${host}"

  local url
  url=$(whiptail --title "$APP_NAME" \
    --inputbox "Enter the URL for FullPageOS to open (include http:// or https://)" \
    12 90 \
    3>&1 1>&2 2>&3) || return 0

  # Basic sanity check
  if [[ -z "${url// }" ]]; then
    whiptail --title "$APP_NAME" --msgbox "URL cannot be empty." 8 50
    return 0
  fi

  local output
  if output=$(
    ssh -p "$port" "$target" -- bash -s -- "$url" 2>&1 <<'EOF'
set -euo pipefail
url="$1"

# Common locations across FullPageOS builds
for f in /boot/firmware/fullpageos.txt /boot/fullpageos.txt; do
  if [[ -f "$f" ]]; then
    echo "$url" | sudo tee "$f" >/dev/null
    echo "Updated: $f"
    echo "New URL: $url"
    exit 0
  fi
done

echo "Could not find fullpageos.txt at /boot/firmware/fullpageos.txt or /boot/fullpageos.txt" >&2
exit 1
EOF
  ); then
    whiptail --title "$APP_NAME" --scrolltext --msgbox "$output" 18 100

    if whiptail --title "$APP_NAME" --yesno "Reboot now to apply the new URL?" 10 70; then
      run_ssh_cmd "$host" "$user" "$port" "sudo -n reboot || sudo reboot"
    fi
  else
    whiptail --title "$APP_NAME" --scrolltext --msgbox "Failed to set URL:\n\n$output" 20 100
  fi
}

# Show help/usage
show_help() {
  cat <<EOF
Usage: $APP_NAME [OPTIONS] [HOST] [COMMAND]

Interactive mode (no arguments):
  $APP_NAME

Standalone CLI mode:
  $APP_NAME HOST COMMAND
  $APP_NAME --host HOST --command COMMAND

Available commands:
EOF
  
  for entry in "${BASE_COMMANDS[@]}"; do
    IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
    echo "  - $cmd_id ($label)"
  done
  
  # Check if we have FullPageOS hosts
  if grep -q "|fullpageos$\|.*|fullpageos$" "$HOSTS_FILE" 2>/dev/null; then
    echo ""
    echo "FullPageOS-specific commands:"
    for entry in "${FULLPAGEOS_COMMANDS[@]}"; do
      IFS='|' read -r label cmd_id remote_cmd <<<"$entry"
      echo "  - $cmd_id ($label)"
    done
  fi
  
  echo ""
  echo "Available hosts:"
  for line in "${HOST_LINES[@]}"; do
    IFS='|' read -r name host user port os <<<"$line"
    echo "  - $name"
  done
}

# Execute command non-interactively
execute_command_cli() {
  local host_name="$1" cmd_id="$2"
  
  # Get host info
  local host_info
  host_info=$(get_host_by_name "$host_name") || {
    echo "Error: Host '$host_name' not found" >&2
    return 1
  }
  
  IFS='|' read -r name host user port os <<<"$host_info"
  
  # Get command info
  local cmd_info
  cmd_info=$(get_command_by_id "$cmd_id" "$os") || {
    echo "Error: Command '$cmd_id' not found for host '$host_name' (OS: $os)" >&2
    return 1
  }
  
  IFS='|' read -r label entry_id remote_cmd <<<"$cmd_info"
  
  # Execute special commands
  if [[ "$remote_cmd" == "__SSH_SHELL__" ]]; then
    exec ssh -p "$port" "${user}@${host}"
  elif [[ "$remote_cmd" == "__SET_FULLPAGEOS_URL__" ]]; then
    echo "Error: set-url requires interactive mode" >&2
    return 1
  fi
  
  # Execute regular SSH command
  local output
  if output=$(ssh -p "$port" "${user}@${host}" -- "$remote_cmd" 2>&1); then
    echo "$output"
    return 0
  else
    echo "$output" >&2
    return 1
  fi
}

# Interactive mode
interactive_mode() {
  while true; do
    host_sel="$(choose_host)" || exit 0
    IFS='|' read -r name host user port os <<<"$host_sel"

    while true; do
      cmd_sel="$(choose_command "$os")" || break
      IFS='|' read -r label cmd_id remote_cmd <<<"$cmd_sel"

      if [[ "$remote_cmd" == "__SET_FULLPAGEOS_URL__" ]]; then
        if whiptail --title "$APP_NAME" --yesno "Set FullPageOS URL on '$name'?" 10 70; then
          set_fullpageos_url "$host" "$user" "$port"
        fi
        continue
      fi

      if whiptail --title "$APP_NAME" --yesno "Run '$label' on '$name'?" 10 70; then
        run_ssh_cmd "$host" "$user" "$port" "$remote_cmd"
      fi

      whiptail --title "$APP_NAME" --yesno "Pick another command for '$name'?" 10 70 || break
    done

    whiptail --title "$APP_NAME" --yesno "Manage another host?" 10 70 || exit 0
  done
}

# Main entry point
if [[ $# -eq 0 ]]; then
  # Interactive mode
  interactive_mode
else
  # CLI mode
  case "$1" in
    --help|-h)
      show_help
      ;;
    *)
      # pibox HOST COMMAND
      if [[ $# -eq 2 ]]; then
        execute_command_cli "$1" "$2" || exit 1
      elif [[ $# -eq 4 && "$1" == "--host" && "$3" == "--command" ]]; then
        execute_command_cli "$2" "$4" || exit 1
      else
        echo "Invalid arguments" >&2
        show_help >&2
        exit 1
      fi
      ;;
  esac
fi
