# pibox API configuration

# Port to run the API server on (default: 3000)
PORT=3000

# Path to the hosts configuration file
# Defaults to ~/.config/pibox/hosts.conf
HOSTS_FILE=~/.config/pibox/hosts.conf

# Path to the API tokens configuration file
# Defaults to ~/.config/pibox/api.conf
API_CONFIG_FILE=~/.config/pibox/api.conf
